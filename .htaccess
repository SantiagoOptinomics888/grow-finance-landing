# ============================================================
#  Grow Finance — sitio estático
#  Reemplaza por completo el .htaccess que genera WordPress.
#  Si se dejan las reglas de WordPress, éste intercepta todas
#  las peticiones y la página nueva NO se muestra.
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- Canónico: HTTPS + www ----
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.growfinance.co/$1 [L,R=301]

  # ---- Páginas de marketing del sitio anterior ----
  RewriteRule ^servicios/?$        /#beneficios  [L,R=301]
  RewriteRule ^nosotros/?$         /#beneficios  [L,R=301]
  RewriteRule ^contacto/?$         /#form        [L,R=301]
  RewriteRule ^elementor-1667/?$   /             [L,R=301]

  # ---- Archivos de categoría ----
  RewriteRule ^kategorie/.*$       /             [L,R=301]

  # ---- Entradas del blog: ahora viven en /blog/<slug>/ ----
  RewriteRule ^como-mejorar-el-flujo-de-caja-de-mi-empresa/?$ /blog/como-mejorar-el-flujo-de-caja-de-mi-empresa/ [L,R=301]
  RewriteRule ^gestion-financiera-pymes/?$ /blog/gestion-financiera-pymes/ [L,R=301]
  RewriteRule ^que-sucede-cuando-los-costos-del-producto-comienzan-a-elevarse-afectando-los-margenes-de-ganancia-y-poniendo-en-riesgo-tu-viabilidad-economica/?$ /blog/que-sucede-cuando-los-costos-del-producto-comienzan-a-elevarse-afectando-los-margenes-de-ganancia-y-poniendo-en-riesgo-tu-viabilidad-economica/ [L,R=301]
  RewriteRule ^la-asesoria-financiera-para-empresas-una-alternativa-clave-para-navegar-en-tiempos-de-incertidumbre-economica/?$ /blog/la-asesoria-financiera-para-empresas-una-alternativa-clave-para-navegar-en-tiempos-de-incertidumbre-economica/ [L,R=301]
  RewriteRule ^analisis-financiero-integral/?$ /blog/analisis-financiero-integral/ [L,R=301]
  RewriteRule ^que-es-mejor-comprar-vivienda-o-arrendar/?$ /blog/que-es-mejor-comprar-vivienda-o-arrendar/ [L,R=301]
  RewriteRule ^ahorro/?$ /blog/ahorro/ [L,R=301]
  RewriteRule ^salud-financiera/?$ /blog/salud-financiera/ [L,R=301]
  RewriteRule ^potencia-tu-pyme/?$ /blog/potencia-tu-pyme/ [L,R=301]
  RewriteRule ^creditos-en-colombia/?$ /blog/creditos-en-colombia/ [L,R=301]
  RewriteRule ^oportunidades-de-inversion/?$ /blog/oportunidades-de-inversion/ [L,R=301]
  RewriteRule ^blogs/?$ /blog/ [L,R=301]

  # ------------------------------------------------------------

  # ---- Rutas internas de WordPress que ya no existen ----
  RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|feed|comments) - [L,R=410]

  # ---- Cualquier otra URL antigua ----
  # Se deja al final para no capturar los assets que sí existen.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ / [L,R=301]
</IfModule>

# ============================================================
#  Rendimiento
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
</IfModule>

# ============================================================
#  Seguridad
# ============================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
